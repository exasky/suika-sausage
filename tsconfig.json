{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "noEmit": false,
    "allowJs": false,
    "types": ["phaser"],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "build",
    "rootDir": "."
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": ["node_modules", "build", "scripts"]
}
